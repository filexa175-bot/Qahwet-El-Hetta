rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.playerId is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 18
        && request.resource.data.avatarIndex is int;
      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','avatarIndex','updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 18
        && request.resource.data.avatarIndex is int;
      allow delete: if false;
    }

    match /playerIds/{playerId} {
      // A signed-in user may check whether an ID is unused, but may only read an existing ID they own.
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/playerIds/$(playerId))
          || resource.data.uid == request.auth.uid);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','createdAt']);
      allow update, delete: if false;
    }

    // Wallet balance is client-accessible only through tightly constrained
    // Firestore writes. A new account may initialize exactly 500 coins once.
    // A daily gift adds exactly 500 coins, with a server-time 24-hour cooldown.
    match /wallets/{uid} {
      allow get: if owns(uid);
      allow list: if false;
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'uid','balance','totalEarned','registrationGiftClaimed',
          'lastDailyGiftAt','createdAt','updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.balance == 500
        && request.resource.data.totalEarned == 500
        && request.resource.data.registrationGiftClaimed == true
        && request.resource.data.lastDailyGiftAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.registrationGiftClaimed == resource.data.registrationGiftClaimed
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'balance','totalEarned','lastDailyGiftAt','updatedAt'
        ])
        && request.resource.data.balance is number
        && request.resource.data.totalEarned is number
        && request.resource.data.balance == resource.data.balance + 500
        && request.resource.data.totalEarned == resource.data.totalEarned + 500
        && request.resource.data.lastDailyGiftAt == request.time
        && request.resource.data.updatedAt == request.time
        && (!('lastDailyGiftAt' in resource.data)
          || resource.data.lastDailyGiftAt == null
          || resource.data.lastDailyGiftAt + duration.value(24, 'h') <= request.time);
      allow delete: if false;
      match /ledger/{entryId} {
        allow read, write: if false;
      }
    }


    // Public, minimal player directory used only for PLAYER ID lookup.
    match /publicProfiles/{playerId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.playerId == playerId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 18
        && request.resource.data.keys().hasOnly(['uid','playerId','displayName','avatarIndex','updatedAt']);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.playerId == playerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','avatarIndex','updatedAt']);
      allow delete: if false;
    }

    // Requests can be created by the sender and answered only by the recipient.
    match /friendRequests/{requestId} {
      // A signed-in sender must be able to check an absent deterministic request
      // document before creating it. Existing requests remain private to participants.
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/friendRequests/$(requestId))
          || resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      // Queries must constrain results to the signed-in user as sender or recipient.
      allow list: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['fromUid','toUid','fromPlayerId','toPlayerId','status','createdAt']);
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
        && request.resource.data.status in ['accepted','declined']
        && request.resource.data.respondedAt == request.time;
      allow delete: if false;
    }


    // Reciprocal friend records are written only when an accepted request exists after the transaction.
    match /friends/{friendshipId} {
      allow get, list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid is string
        && request.resource.data.friendUid is string
        && request.resource.data.ownerUid != request.resource.data.friendUid
        && (request.resource.data.ownerUid == request.auth.uid
          || request.resource.data.friendUid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['ownerUid','friendUid','friendPlayerId','createdAt'])
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.ownerUid + '__' + request.resource.data.friendUid))
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.ownerUid + '__' + request.resource.data.friendUid)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.ownerUid + '__' + request.resource.data.friendUid)).data.fromUid == request.resource.data.ownerUid
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.ownerUid + '__' + request.resource.data.friendUid)).data.toUid == request.resource.data.friendUid;
      allow update, delete: if false;
    }

    // Presence is visible only to the player and accepted friends.
    match /presence/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid
        || exists(/databases/$(database)/documents/friends/$(request.auth.uid + '__' + uid)));
      allow list: if false;
      allow create, update: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.online is bool
        && request.resource.data.lastSeen == request.time
        && request.resource.data.keys().hasOnly(['uid','online','lastSeen']);
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}