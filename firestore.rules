rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function reqPath(a,b) { return /databases/$(database)/documents/friendRequests/$(a + '__' + b); }
    function frPath(a,b) { return /databases/$(database)/documents/friends/$(a + '__' + b); }
    function countPath(uid) { return /databases/$(database)/documents/friendCounts/$(uid); }
    function requestAccepted(a,b) {
      let p = /databases/$(database)/documents/friendRequests/$(a + '__' + b);
      return existsAfter(p) && getAfter(p).data.fromUid == a
        && getAfter(p).data.toUid == b && getAfter(p).data.status == 'accepted'
        && getAfter(p).data.toUid == request.auth.uid;
    }
    function acceptedTransition(a,b) {
      let p = /databases/$(database)/documents/friendRequests/$(a + '__' + b);
      let q = /databases/$(database)/documents/friendRequests/$(b + '__' + a);
      return (exists(p) && get(p).data.status == 'pending' && existsAfter(p) && getAfter(p).data.status == 'accepted')
        || (exists(q) && get(q).data.status == 'pending' && existsAfter(q) && getAfter(q).data.status == 'accepted');
    }
    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && request.resource.data.uid == uid
        && request.resource.data.playerId is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 18
        && request.resource.data.avatarIndex is int;
      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','avatarIndex','updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 18
        && request.resource.data.avatarIndex is int;
      allow delete: if false;
    }

    match /playerIds/{playerId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/playerIds/$(playerId)) || resource.data.uid == request.auth.uid);
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','createdAt']);
      allow update, delete: if false;
    }

    match /wallets/{uid} {
      allow get: if owns(uid);
      allow list: if false;
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly(['uid','balance','totalEarned','registrationGiftClaimed','lastDailyGiftAt','createdAt','updatedAt'])
        && request.resource.data.uid == uid && request.resource.data.balance == 500
        && request.resource.data.totalEarned == 500 && request.resource.data.registrationGiftClaimed == true
        && request.resource.data.lastDailyGiftAt == null
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.registrationGiftClaimed == resource.data.registrationGiftClaimed
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance','totalEarned','lastDailyGiftAt','updatedAt'])
        && request.resource.data.balance == resource.data.balance + 500
        && request.resource.data.totalEarned == resource.data.totalEarned + 500
        && request.resource.data.lastDailyGiftAt == request.time && request.resource.data.updatedAt == request.time
        && (!('lastDailyGiftAt' in resource.data) || resource.data.lastDailyGiftAt == null
          || resource.data.lastDailyGiftAt + duration.value(24, 'h') <= request.time);
      allow delete: if false;
      match /ledger/{entryId} { allow read, write: if false; }
    }

    match /publicProfiles/{playerId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.playerId == playerId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 18
        && request.resource.data.keys().hasOnly(['uid','playerId','displayName','avatarIndex','updatedAt']);
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.playerId == playerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','avatarIndex','updatedAt']);
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/friendRequests/$(requestId))
        || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow list: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && requestId == request.resource.data.fromUid + '__' + request.resource.data.toUid
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['fromUid','toUid','fromPlayerId','toPlayerId','fromDisplayName','toDisplayName','status','createdAt'])
        && request.resource.data.fromDisplayName is string && request.resource.data.toDisplayName is string;
      allow update: if signedIn() && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
        && request.resource.data.status in ['accepted','declined']
        && request.resource.data.respondedAt == request.time
        && (request.resource.data.status == 'declined'
          || (existsAfter(/databases/$(database)/documents/friends/$(resource.data.fromUid + '__' + resource.data.toUid))
            && existsAfter(/databases/$(database)/documents/friends/$(resource.data.toUid + '__' + resource.data.fromUid))
            && existsAfter(/databases/$(database)/documents/friendCounts/$(resource.data.fromUid))
            && existsAfter(/databases/$(database)/documents/friendCounts/$(resource.data.toUid))));
      allow delete: if false;
    }

    match /friends/{friendshipId} {
      allow get, list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid is string && request.resource.data.friendUid is string
        && request.resource.data.ownerUid != request.resource.data.friendUid
        && friendshipId == request.resource.data.ownerUid + '__' + request.resource.data.friendUid
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['ownerUid','friendUid','friendPlayerId','createdAt'])
        && requestAccepted(request.resource.data.ownerUid,request.resource.data.friendUid)
        && request.auth.uid == request.resource.data.friendUid;
      allow update, delete: if false;
    }

    match /friendCounts/{uid} {
      allow get: if owns(uid);
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.uid == uid
        && request.resource.data.count is int
        && request.resource.data.count <= 15
        && request.resource.data.count >= 1
        && request.resource.data.lastFriendUid is string
        && request.resource.data.lastFriendUid != uid
        && request.auth.uid in [uid, request.resource.data.lastFriendUid]
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(['uid','count','lastFriendUid','updatedAt'])
        && (exists(countPath(uid))
          ? request.resource.data.count == get(countPath(uid)).data.count + 1
          : request.resource.data.count == 1)
        && acceptedTransition(uid,request.resource.data.lastFriendUid)
        && existsAfter(/databases/$(database)/documents/friends/$(uid + '__' + request.resource.data.lastFriendUid));
      allow delete: if false;
    }

    match /presence/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid
        || exists(/databases/$(database)/documents/friends/$(request.auth.uid + '__' + uid)));
      allow list: if false;
      allow create, update: if owns(uid) && request.resource.data.uid == uid
        && request.resource.data.online is bool && request.resource.data.lastSeen == request.time
        && request.resource.data.keys().hasOnly(['uid','online','lastSeen']);
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}